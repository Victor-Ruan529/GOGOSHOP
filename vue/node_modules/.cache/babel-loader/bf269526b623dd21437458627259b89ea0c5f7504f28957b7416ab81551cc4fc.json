{"ast":null,"code":"export default {\n  data() {\n    return {\n      carouselData: [],\n      goodsData: [],\n      user: JSON.parse(localStorage.getItem('xm-user') || '{}'),\n      typeData: [],\n      top: null,\n      notice: []\n    };\n  },\n  mounted() {\n    this.lodeType();\n    this.lodeNotice();\n    this.lodeGoods();\n    this.loadCarousel();\n  },\n  // methods：本页面所有的点击事件或者其他函数定义区\n  methods: {\n    loadCarousel() {\n      this.$request.get('/carousel/selectAll').then(res => {\n        if (res.code === '200') {\n          this.carouselData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    lodeGoods() {\n      this.$request.get('/goods/selectTop10').then(res => {\n        if (res.code === '200') {\n          this.goodsData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    },\n    lodeNotice() {\n      this.$request.get('/notice/selectAll').then(res => {\n        this.notice = res.data;\n        let i = 0;\n        if (this.notice && this.notice.length) {\n          this.top = this.notice[0].content;\n          //定时器\n          setInterval(() => {\n            this.top = this.notice[i].content;\n            i++;\n            if (i === this.notice.length) {\n              i = 0;\n            }\n          }, 2500);\n        }\n      });\n    },\n    navTo(url) {\n      location.href = url;\n    },\n    lodeType() {\n      this.$request.get('/type/selectAll').then(res => {\n        if (res.code === '200') {\n          this.typeData = res.data;\n        } else {\n          this.$message.error(res.msg);\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["data","carouselData","goodsData","user","JSON","parse","localStorage","getItem","typeData","top","notice","mounted","lodeType","lodeNotice","lodeGoods","loadCarousel","methods","$request","get","then","res","code","$message","error","msg","i","length","content","setInterval","navTo","url","location","href"],"sources":["src/views/front/Home.vue"],"sourcesContent":["\r\n<template>\r\n  <div class=\"main-content\">\r\n    <div style=\"height: 60px; background-color: rgb(197,102,246)\"></div>\r\n    <div style=\"display: flex\">\r\n      <div class=\"left\"></div>\r\n      <div style=\"width: 66%; margin-bottom: 50px; background-color: white\">\r\n        <div style=\"color: #FE0137FF; margin: 15px 0px 15px 18px; front-size: 20px; font-weight: bold\">主题市场</div>\r\n        <div style=\"display: flex; margin: 0px 25px; height: 545px\">\r\n\r\n          <div style=\"flex: 2\">\r\n            <div style=\"display: flex; color: #666666FF; margin: 14px 0px\" v-for=\"item in typeData\">\r\n              <img :src=\"item.img\" alt=\"\" style=\"height: 20px; width: 20px\">\r\n            <div style=\"margin-left: 10px; font-size: 14px\"><a href=\"#\" @click=\"navTo('/front/type?id=' + item.id)\">{{item.name}}</a></div>\r\n            </div>\r\n          </div>\r\n\r\n          <div style=\"flex: 5; margin-top: 15px\">\r\n            <div>\r\n            <el-carousel height=\"300px\" style=\"border-radius: 10px\">\r\n              <el-carousel-item v-for=\"item in carouselData\">\r\n                <img :src=\"item.img\" alt=\"\" style=\"width: 100%; height: 300px; border-radius: 10px\">\r\n              </el-carousel-item>\r\n            </el-carousel>\r\n            </div>\r\n          </div>\r\n          <div style=\"flex: 3; background-color: #F3F3F3FF; margin-top: 15px; margin-left: 15px; border-radius: 10px\">\r\n            <div style=\"text-align: center; margin-top: 30px\">\r\n              <img @click=\"navTo('/front/person')\" :src=\"user.avatar\" alt=\"\" style=\"width: 80px; height: 80px; border-radius: 50%\">\r\n              <div style=\"margin-top: 10px\">Hi,{{user.name}}</div>\r\n            </div>\r\n            <div style=\"margin-top: 20px; padding: 0px 15px\">\r\n              <img src='@/assets/imgs/right.png' alt=\"\" style=\"height: 150px; width: 100%;border-radius: 20px\">\r\n            </div>\r\n            <div style=\"margin: 20px 0px 10px 10px; width: 250px; white-space: nowrap; overflow: hidden;text-overflow: ellipsis\">\r\n              <i class=\"el-icon-bell\"></i>\r\n              <span style=\"font-weight: bold\">公告</span>\r\n              <span style=\"color: #666666\">：{{ top }}</span>\r\n            </div>\r\n            <div style=\"display: flex; margin-top: 50px\">\r\n            <div style=\"flex: 1; text-align: center\">\r\n              <a href=\"#\" @click=\"navTo('/front/collect')\">\r\n              <img src=\"@/assets/imgs/收藏.png\" alt=\"\" style=\"height: 25px; width: 25px\">\r\n              <div>我的收藏</div>\r\n              </a>\r\n            </div>\r\n<!--            <div style=\"flex: 1; text-align: center\">-->\r\n<!--              <img src=\"@/assets/imgs/店铺.png\" alt=\"\" style=\"height: 25px; width: 25px\">-->\r\n<!--              <div>我的地址</div>-->\r\n<!--            </div>-->\r\n<!--            <div style=\"flex: 1; text-align: center\">-->\r\n<!--              <img src=\"@/assets/imgs/购物车.png\" alt=\"\" style=\"height: 25px; width: 25px\">-->\r\n<!--              <div>我的购物车</div>-->\r\n<!--            </div>-->\r\n            <div style=\"flex: 1; text-align: center\">\r\n              <a href=\"#\" @click=\"navTo('/front/orders')\">\r\n              <img src=\"@/assets/imgs/订单.png\" alt=\"\" style=\"height: 25px; width: 25px\">\r\n              <div>我的订单</div>\r\n              </a>\r\n            </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"list\">热卖商品</div>\r\n        <div style=\"margin: 10px 5px 0px 5px\">\r\n          <el-row >\r\n            <el-col :span=\"5\" v-for=\"item in goodsData\">\r\n              <img @click=\"navTo('/front/detail?id=' + item.id)\" :src=\"item.img\" alt=\"\" style=\"height: 180px; width: 100%; border-radius: 10px;border: 1px solid rgb(204,204,204)\">\r\n              <div class=\"text\" style=\"margin-top: 10px; font-size: 18px; font-weight: 1000; color: rgb(0,0,0)\">{{item.name}}</div>\r\n              <div style=\"margin-top: 5px; color: rgb(255,80,0);font-size: 20px; font-weight: 1000\">￥：{{item.price}}/{{item.unit}}</div>\r\n            </el-col >\r\n          </el-row>\r\n        </div>\r\n      </div>\r\n      <div class=\"right\"></div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\n  export default {\r\n\r\n  data() {\r\n    return {\r\n      carouselData:[],\r\n      goodsData:[],\r\n      user:JSON.parse(localStorage.getItem('xm-user') || '{}' ),\r\n      typeData:[],\r\n      top:null,\r\n      notice:[],\r\n    }\r\n  },\r\n  mounted() {\r\n    this.lodeType()\r\n    this.lodeNotice()\r\n    this.lodeGoods()\r\n    this.loadCarousel()\r\n  },\r\n  // methods：本页面所有的点击事件或者其他函数定义区\r\n  methods: {\r\n    loadCarousel(){\r\n      this.$request.get('/carousel/selectAll').then(res =>{\r\n        if(res.code === '200'){\r\n          this.carouselData = res.data\r\n        }else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    lodeGoods(){\r\n      this.$request.get('/goods/selectTop10').then(res => {\r\n        if(res.code === '200'){\r\n          this.goodsData = res.data\r\n        } else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    },\r\n    lodeNotice() {\r\n      this.$request.get('/notice/selectAll').then(res => {\r\n        this.notice = res.data\r\n        let i = 0\r\n        if (this.notice && this.notice.length) {\r\n          this.top = this.notice[0].content\r\n          //定时器\r\n          setInterval(() => {\r\n            this.top = this.notice[i].content\r\n            i++\r\n            if (i === this.notice.length) {\r\n              i = 0\r\n            }\r\n          }, 2500)\r\n        }\r\n      })\r\n    },\r\n    navTo(url) {\r\n      location.href = url\r\n    },\r\n    lodeType(){\r\n      this.$request.get('/type/selectAll').then(res =>{\r\n        if(res.code === '200'){\r\n          this.typeData = res.data\r\n        }else {\r\n          this.$message.error(res.msg)\r\n        }\r\n      })\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n.left{\r\n  width: 17%;\r\n  background-repeat: no-repeat;\r\n  background-image: url(\"@/assets/imgs/left-img.png\");\r\n}\r\n.right{\r\n  width:17%;\r\n  background-repeat: no-repeat;\r\n  background-image: url(\"@/assets/imgs/right-img.png\");\r\n}\r\n.main-content{\r\n  min-height: 100vh;\r\n  background-size: 100%;\r\n  background-image: url(\"@/assets/imgs/img.png\");\r\n}\r\n.list{\r\n  margin: 40px 0px 0px 15px;\r\n  height: 40px;\r\n  background-color: #5580d4;\r\n  font-size: 20px;\r\n  color: white;\r\n  text-align: center;\r\n  width: 130px;\r\n  height: 40px;\r\n  line-height: 40px;\r\n  font-weight: bold;\r\n  border-radius: 20px;\r\n}\r\n.el-col-5{\r\n  width: 20%;\r\n  max-width: 20%;\r\n  padding: 10px 10px;\r\n}\r\n/*超出文本的字体显示'...'*/\r\n.text{\r\n  text-overflow: ellipsis;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;/*能显示内容的行数*/\r\n  -webkit-box-orient: vertical;\r\n}\r\n</style>\r\n"],"mappings":"AAiFA;EAEAA,KAAA;IACA;MACAC,YAAA;MACAC,SAAA;MACAC,IAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,QAAA;MACAC,GAAA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,QAAA;IACA,KAAAC,UAAA;IACA,KAAAC,SAAA;IACA,KAAAC,YAAA;EACA;EACA;EACAC,OAAA;IACAD,aAAA;MACA,KAAAE,QAAA,CAAAC,GAAA,wBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAApB,YAAA,GAAAmB,GAAA,CAAApB,IAAA;QACA;UACA,KAAAsB,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;IACAV,UAAA;MACA,KAAAG,QAAA,CAAAC,GAAA,uBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAnB,SAAA,GAAAkB,GAAA,CAAApB,IAAA;QACA;UACA,KAAAsB,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;IACAX,WAAA;MACA,KAAAI,QAAA,CAAAC,GAAA,sBAAAC,IAAA,CAAAC,GAAA;QACA,KAAAV,MAAA,GAAAU,GAAA,CAAApB,IAAA;QACA,IAAAyB,CAAA;QACA,SAAAf,MAAA,SAAAA,MAAA,CAAAgB,MAAA;UACA,KAAAjB,GAAA,QAAAC,MAAA,IAAAiB,OAAA;UACA;UACAC,WAAA;YACA,KAAAnB,GAAA,QAAAC,MAAA,CAAAe,CAAA,EAAAE,OAAA;YACAF,CAAA;YACA,IAAAA,CAAA,UAAAf,MAAA,CAAAgB,MAAA;cACAD,CAAA;YACA;UACA;QACA;MACA;IACA;IACAI,MAAAC,GAAA;MACAC,QAAA,CAAAC,IAAA,GAAAF,GAAA;IACA;IACAlB,SAAA;MACA,KAAAK,QAAA,CAAAC,GAAA,oBAAAC,IAAA,CAAAC,GAAA;QACA,IAAAA,GAAA,CAAAC,IAAA;UACA,KAAAb,QAAA,GAAAY,GAAA,CAAApB,IAAA;QACA;UACA,KAAAsB,QAAA,CAAAC,KAAA,CAAAH,GAAA,CAAAI,GAAA;QACA;MACA;IACA;EACA;AACA"},"metadata":{},"sourceType":"module","externalDependencies":[]}
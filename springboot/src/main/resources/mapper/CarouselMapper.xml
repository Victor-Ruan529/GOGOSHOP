<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.CarouselMapper">

    <sql id="Base_Column_List">
        id,img,name,time,"user"
    </sql>

    <select id="selectAll" resultType="com.example.entity.Carousel">
        select <include refid="Base_Column_List"/>
        from carousel
        <where>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
        </where>
        order by id asc
    </select>

    <select id="selectById" resultType="com.example.entity.Carousel">
        select <include refid="Base_Column_List"/> from carousel where id = #{id}
    </select>

    <delete id="deleteById">
        delete from carousel where id = #{id}
    </delete>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into carousel
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="img != null">img,</if>
            <if test="name != null">name,</if>
            <if test="time != null">time,</if>
            <if test="user != null">"user",</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="img != null">#{img},</if>
            <if test="name != null">#{name},</if>
            <if test="time != null">#{time},</if>
            <if test="user != null">#{user},</if>
        </trim>
    </insert>

    <update id="updateById">
        update carousel
        <set>
            <!-- 保证所有字段都为空时 SQL 仍然合法 -->
            id = #{id},
            <if test="img != null">img = #{img},</if>
            <if test="name != null">name = #{name},</if>
            <if test="time != null">time = #{time},</if>
            <if test="user != null">"user" = #{user},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
